{
  "version": 2,
  "builds": [
    {
      "src": "api/gateway.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/\\.netlify/functions/gateway",
      "dest": "/api/gateway.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}